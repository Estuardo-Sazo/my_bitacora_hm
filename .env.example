# Supabase project (Project Settings > API). These values identify the project and are public by
# design: access control lives in the database policies. Never put a secret or service_role key
# here. Without them the app still runs, in demo mode only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Set to true after configuring the Google provider in Supabase.
VITE_AUTH_GOOGLE=false
